{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-AU,en-GB",
  "ignorePaths": [
    "node_modules/**",
    "package-lock.json",
    "extensions/*/themes/**",
    "extensions/*/icons/**",
    "**/*.lock.yml"
  ],
  "ignoreRegExpList": [
    "/#[0-9A-Fa-f]{3,8}\\b/g",
    "/&[a-z]+;/g"
  ],
  "words": [
    "agentic",
    "alertsmanagement",
    "CCSK",
    "CCSP",
    "Chainring",
    "CHARLI",
    "CISSP",
    "CMYK",
    "CODEOWNERS",
    "CSPM",
    "cybermattlee",
    "desaturate",
    "desaturates",
    "desaturating",
    "Draffin",
    "dups",
    "EMEA",
    "Entra",
    "gotchas",
    "GTIA",
    "idempotently",
    "inlines",
    "keithoak",
    "keybinding",
    "letterform",
    "lookups",
    "lucidlabs",
    "MSDO",
    "namespacing",
    "nonprod",
    "Pantone",
    "passthrough",
    "PNPT",
    "Progenesis",
    "pwsh",
    "rollout",
    "RRGGBB",
    "RRGGBBAA",
    "runbooks",
    "sanitization",
    "scripters",
    "Stackframe",
    "TMDL",
    "toggleable",
    "unparseable",
    "vcfg",
    "vscodeignore",
    "vslug",
    "waratah",
    "WCAG",
    "Wordmark"
  ]
}
